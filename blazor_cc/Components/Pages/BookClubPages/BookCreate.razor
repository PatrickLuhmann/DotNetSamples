@page "/bookclub/book-create"
@rendermode InteractiveServer

@using BookKlubKorner.Domain
@using BookKlubKorner.Model
@using blazor_cc.ViewModels

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Create New Book</PageTitle>

@if (BookToCreate is null)
{
	<p>Gathering the materials needed to create a new book...</p>
}
else
{
	<div class="row">
		<div class="col-md-4">
			@* In order to "see" the data annotations, we must explicitly reference BookEntity in Model property. *@
			<EditForm method="post" Model="BookToCreate" OnValidSubmit="CreateBook" FormName="createbook" Enhance>
				<DataAnnotationsValidator/>
				<ValidationSummary role="alert"/>
				<div class="mb-3">
					<label for="title" class="form-label">Title:</label>
					<InputText id="title" @bind-Value="BookToCreate.Title" class="form-control"/>
					<ValidationMessage For="() => BookToCreate.Title" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="author" class="form-label">Author:</label>
					<InputText id="author" @bind-Value="BookToCreate.Author" class="form-control"/>
					<ValidationMessage For="() => BookToCreate.Author" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="publisher" class="form-label">Publisher:</label>
					<InputText id="publisher" @bind-Value="BookToCreate.Publisher" class="form-control"/>
					<ValidationMessage For="() => BookToCreate.Publisher" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="pages" class="form-label">Number Of Pages:</label>
					<InputNumber id="pages" @bind-Value="BookToCreate.NumPages" class="form-control"/>
					<ValidationMessage For="() => BookToCreate.NumPages" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="year" class="form-label">Year Published:</label>
					<InputNumber id="year" @bind-Value="BookToCreate.PublicationYear" class="form-control"/>
					<ValidationMessage For="() => BookToCreate.PublicationYear" class="text-danger"/>
				</div>
				<button type="submit" class="btn btn-primary">Create</button>
				<a href="/bookclub/book-index" class="btn btn-info">Back To Book List</a>
			</EditForm>
		</div>
	</div>
}

@code {

	[SupplyParameterFromForm]
	private BookViewModel? BookToCreate { get; set; }

	protected override void OnInitialized()
	{
		BookToCreate = new BookViewModel();
	}

	private async Task CreateBook()
	{
		var bookEntity = new Book()
		{
			Title = BookToCreate!.Title,
			Author = BookToCreate!.Author,
			Publisher = BookToCreate!.Publisher,
			NumPages = BookToCreate!.NumPages,
			PublicationYear = BookToCreate!.PublicationYear,
		};
		await BookKlubKornerService.CreateBookAsync(bookEntity);

		NavigationManager.NavigateTo("/bookclub/book-index");
	}

}