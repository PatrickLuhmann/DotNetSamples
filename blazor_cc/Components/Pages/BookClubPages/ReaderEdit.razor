@page "/bookclub/reader-edit"
@rendermode InteractiveServer

@using BookKlubKorner.Domain
@using BookKlubKorner.Model
@using blazor_cc.ViewModels

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Edit Reader</PageTitle>

@if (ReaderToEdit is null)
{
	<p>Searching personnel records for the reader you requested...</p>
}
else
{
	<div class="row">
		<div class="col-md-4">
			@* In order to "see" the data annotations, we must explicitly reference ReaderEntity in Model property. *@
			<EditForm method="post" Model="ReaderToEdit" OnValidSubmit="UpdateReader" FormName="editreader" Enhance>
				<DataAnnotationsValidator/>
				<ValidationSummary role="alert"/>
				<div class="mb-3">
					<label for="nickname" class="form-label">Nickname:</label>
					<InputText id="nickname" @bind-Value="ReaderToEdit.Nickname" class="form-control"/>
					<ValidationMessage For="() => ReaderToEdit.Nickname" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="biography" class="form-label">Biography:</label>
					<InputText id="biography" @bind-Value="ReaderToEdit.Biography" class="form-control"/>
					<ValidationMessage For="() => ReaderToEdit.Biography" class="text-danger"/>
				</div>
				<button type="submit" class="btn btn-primary">Update</button>
				<a href="/bookclub/reader-index" class="btn btn-info">Back To Reader List</a>
			</EditForm>
		</div>
	</div>
}

@code {

	[SupplyParameterFromQuery]
	private int Id { get; set; }

	[SupplyParameterFromForm]
	private ReaderViewModel? ReaderToEdit { get; set; }

	protected override async Task OnInitializedAsync()
	{
		var readerEntity = await BookKlubKornerService.GetReaderByIdAsync(Id);
		if (readerEntity is null)
			NavigationManager.NotFound();
		else
			ReaderToEdit = new ReaderViewModel(readerEntity);
	}

	private async Task UpdateReader()
	{
		var readerEntity = new Reader()
		{
			Id = Id,
			Nickname = ReaderToEdit!.Nickname,
			Biography = ReaderToEdit!.Biography,
		};
		await BookKlubKornerService.UpdateReaderAsync(readerEntity);
		NavigationManager.NavigateTo("/bookclub/reader-index");
	}

}