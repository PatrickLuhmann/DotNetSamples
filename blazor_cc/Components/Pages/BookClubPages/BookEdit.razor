@page "/bookclub/book-edit"

@using BookKlubKorner.Domain
@using BookKlubKorner.Model
@using blazor_cc.ViewModels

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Edit Book</PageTitle>

@if (BookToEdit is null)
{
	<p>Searching the vast library for the book you requested...</p>
}
else
{
	<div class="row">
		<div class="col-md-4">
			<EditForm method="post" Model="BookToEdit" OnValidSubmit="UpdateBook" FormName="editbook" Enhance>
				<DataAnnotationsValidator/>
				<ValidationSummary role="alert"/>
				<div class="mb-3">
					<label for="title" class="form-label">Title:</label>
					<InputText id="title" @bind-Value="BookToEdit.Title" class="form-control"/>
				</div>
				<div class="mb-3">
					<label for="author" class="form-label">Author:</label>
					<InputText id="author" @bind-Value="BookToEdit.Author" class="form-control"/>
				</div>
				<div class="mb-3">
					<label for="publisher" class="form-label">Publisher:</label>
					<InputText id="publisher" @bind-Value="BookToEdit.Publisher" class="form-control"/>
				</div>
				<div class="mb-3">
					<label for="pages" class="form-label">Number Of Pages:</label>
					<InputNumber id="pages" @bind-Value="BookToEdit.NumPages" class="form-control"/>
				</div>
				<div class="mb-3">
					<label for="year" class="form-label">Year Published:</label>
					<InputNumber id="year" @bind-Value="BookToEdit.PublicationYear" class="form-control"/>
				</div>
				<button type="submit" class="btn btn-primary">Update</button>
				<a href="/bookclub/book-index" class="btn btn-info">Back To Book List</a>
			</EditForm>
		</div>
	</div>
}

@code {

	[SupplyParameterFromQuery]
	private int Id { get; set; }

	[SupplyParameterFromForm]
	private BookViewModel? BookToEdit { get; set; }

	@*
	   This is called once when the component is loaded (there is no pre-render).
	   This is also called on form submit, before the submit callback. In that case,
	   we don't want to overwrite BookToEdit, which is why we check for null before
	   getting a new object.
	*@
	protected override async Task OnInitializedAsync()
	{
		var bookEntity = await BookKlubKornerService.GetBookByIdAsync(Id);
		if (bookEntity is null)
			NavigationManager.NotFound();
		else
			BookToEdit ??= new BookViewModel
			{
				Title = bookEntity.Title,
				Author = bookEntity.Author,
				Publisher = bookEntity.Publisher,
				NumPages = bookEntity.NumPages,
				PublicationYear = bookEntity.PublicationYear,
			};
	}

	private async Task UpdateBook()
	{
		// Data validation goes here if not in the VM class.
		var bookEntity = new Book()
		{
			Id = Id,
			NumPages = BookToEdit!.NumPages,
			PublicationYear = BookToEdit!.PublicationYear,
			Publisher = BookToEdit!.Publisher!,
			Author = BookToEdit!.Author!,
			Title = BookToEdit!.Title!,
		};
		await BookKlubKornerService.UpdateBookAsync(bookEntity);
		NavigationManager.NavigateTo("/bookclub/book-index");
	}

}