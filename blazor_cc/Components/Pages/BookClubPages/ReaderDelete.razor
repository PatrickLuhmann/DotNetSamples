@page "/bookclub/reader-delete"

@using BookKlubKorner.Domain
@using BookKlubKorner.Model

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Delete Reader</PageTitle>

<p>Reader Information</p>

@if (ReaderToDelete is null)
{
	<p>Searching the vast library for the reader you requested...</p>
}
else
{
	<div>
		<dl class="row">
			<dt class="col-sm-2">Nickname</dt>
			<dd class="col-sm-10">@ReaderToDelete.ReaderEntity!.Nickname</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Biography</dt>
			<dd class="col-sm-10">@ReaderToDelete.ReaderEntity!.Biography</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Number Of Books</dt>
			<dd class="col-sm-10">@ReaderToDelete.ReaderEntity!.BookStatuses.Count</dd>
		</dl>
		<p>Do you want to delete this reader?</p>
		<EditForm method="post" Model="ReaderToDelete" OnValidSubmit="DeleteReader" FormName="delete" Enhance>
			<button type="submit" class="btn btn-danger" disabled="@(ReaderToDelete is null)">Delete</button>
			<a href="/bookclub/reader-index" class="btn btn-info">Back To Reader List</a>
		</EditForm>
	</div>
}

@code {

	[SupplyParameterFromQuery]
	private int Id { get; set; }

	[SupplyParameterFromForm]
	private DeleteReaderViewModel? ReaderToDelete { get; set; }

	protected override async Task OnInitializedAsync()
	{
		if (ReaderToDelete is null)
		{
			var readerEntity = await BookKlubKornerService.GetReaderByIdAsync(Id);
			if (readerEntity is null)
				NavigationManager.NotFound();
			else
				ReaderToDelete = new()
				{
					ReaderEntity = readerEntity
				};
		}
	}

	private async Task DeleteReader()
	{
		await BookKlubKornerService.DeleteReaderAsync(Id);

		NavigationManager.NavigateTo("/bookclub/reader-index");
	}

	class DeleteReaderViewModel
	{
		public Reader? ReaderEntity { get; init; }
	}

}
