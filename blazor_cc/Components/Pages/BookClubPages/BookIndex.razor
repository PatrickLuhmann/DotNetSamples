@page "/bookclub/book-index"

@using BookKlubKorner.Domain
@using BookKlubKorner.Model
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IBookKlubKornerService BookKlubKornerService

<h1>Books In The Book Club</h1>

<a href="/bookclub/book-create">Create New Book</a>
<a href="/bookclub">Back To Book Club Home</a>

<div>
	<QuickGrid Class="table" Items="QuickBooks">
		<PropertyColumn Property="book => book.Title" Sortable="true"/>
		<PropertyColumn Property="book => book.Author" Sortable="true"/>
		<PropertyColumn Property="book => book.PublicationYear" Title="Publication Year"/>
		<PropertyColumn Property="book => book.NumPages" title="Number Of Pages"/>
		<PropertyColumn Property="book => book.Publisher"/>

		<TemplateColumn Context="book">
			<a href="@($"bookclub/book-edit?id={book.Id}")">Edit</a> |
			<a href="@($"bookclub/book-delete?id={book.Id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

@code {
	List<Book> _books = [];
	IQueryable<Book> QuickBooks => _books.AsQueryable();

	protected override async Task OnInitializedAsync()
	{
		_books = await BookKlubKornerService.GetAllBooksAsync();
	}

}