@page "/bookclub/reader-create"

@using BookKlubKorner.Domain
@using BookKlubKorner.Model

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Create New Reader</PageTitle>

@if (ReaderToCreate is null)
{
	<p>Gathering the materials needed to create a new reader...</p>
}
else
{
	<div class="row">
		<div class="col-md-4">
			@* In order to "see" the data annotations, we must explicitly reference ReaderEntity in Model property. *@
			<EditForm method="post" Model="ReaderToCreate" OnValidSubmit="CreateReader" FormName="createreader" Enhance>
				<DataAnnotationsValidator/>
				<ValidationSummary role="alert"/>
				<div class="mb-3">
					<label for="nickname" class="form-label">Nickname:</label>
					<InputText id="nickname" @bind-Value="ReaderToCreate!.Nickname" class="form-control"/>
					<ValidationMessage For="() => ReaderToCreate.Nickname" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="biography" class="form-label">Biography:</label>
					<InputText id="biography" @bind-Value="ReaderToCreate!.Biography" class="form-control"/>
					<ValidationMessage For="() => ReaderToCreate.Biography" class="text-danger"/>
				</div>
				<button type="submit" class="btn btn-primary">Create</button>
				<a href="/bookclub/reader-index" class="btn btn-info">Back To Reader List</a>
			</EditForm>
		</div>
	</div>
}

@code {

	[SupplyParameterFromForm]
	private CreateReaderViewModel? ReaderToCreate { get; set; }

	@*
	   This is called once when the component is loaded (there is no pre-render).
	   This is also called on form submit, before the submit callback. In that case,
	   we don't want to overwrite ReaderToCreate, which is why we check for null before
	   getting a new object.
	*@
	protected override void OnInitialized()
	{
		ReaderToCreate ??= new()
		{
			//ReaderEntity = new Reader(),
		};
	}

	private async Task CreateReader()
	{
		var readerEntity = new Reader()
		{
			Nickname = ReaderToCreate.Nickname,
			Biography = ReaderToCreate.Biography,
		};
		await BookKlubKornerService.CreateReaderAsync(readerEntity!);

		NavigationManager.NavigateTo("/bookclub/reader-index");
	}

	class CreateReaderViewModel
	{
		//public Reader? ReaderEntity { get; init; }
		public string Nickname { get; set; } = string.Empty;
		public string Biography { get; set; } = string.Empty;
	}

}