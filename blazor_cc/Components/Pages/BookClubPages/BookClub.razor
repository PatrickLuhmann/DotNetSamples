@page "/bookclub"

@using BookKlubKorner.Domain

@inject IBookKlubKornerService BookKlubKornerService

<h3>Welcome To The Book Club</h3>

<p>
	There are @_bookCount books in the library.
	<a href="/bookclub/book-index">Go to books</a>
</p>

<p>
	There are @_readerCount readers in the library.
	<a href="/bookclub/reader-index">Go to readers</a>
</p>

@code {

	int _bookCount;
	int _readerCount;

	protected override async Task OnInitializedAsync()
	{
		_bookCount = await BookKlubKornerService.GetCountOfBooksAsync();
		_readerCount = await BookKlubKornerService.GetCountOfReadersAsync();
	}

}