@page "/bookclub/reader-manage"
@rendermode InteractiveServer

@using blazor_cc.ViewModels
@using BookKlubKorner.Domain
@using BookKlubKorner.Model

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Manage Reader</PageTitle>

@if (ReaderToManage is null)
{
	<p>Searching personnel records for the reader you requested...</p>
}
else
{
	<p>Reader: @ReaderToManage.Nickname</p>
	<p>They have @ReaderToManage.BookStatusIds.Count books in their collection.</p>
	<ul>
		@foreach (var status in ReadersBooks)
		{
			<li>
				Book ID: @status.BookId
				Progress: @status.Progress %
				Title: @GetBookTitle(status.BookId)
				<button>Button</button>
				<a href="/bookclub/reader-index">Link</a>
			</li>
		}
	</ul>

	<h2>Available Books (Independent VM)</h2>
	<ul>
		@foreach (var book in _availableBooks)
		{
			<li>
				<input type="checkbox" @bind="book.IsSelected"/>
				@book.Title
			</li>
		}
	</ul>

	<h2>Available Books (Subclass VM)</h2>
	<ul>
		@foreach (var book in _availableBooksAlt)
		{
			<li>
				<input type="checkbox" @bind="book.IsSelected"/>
				@book.Title
			</li>
		}
	</ul>

	<button @onclick="UpdateBooksInCollection">Update</button>
	<a href="/bookclub/reader-index" class="btn btn-info">Back To Reader List</a>
}

@code {

	[SupplyParameterFromQuery]
	private int Id { get; set; }

	ReaderViewModel? ReaderToManage { get; set; }
	List<BookStatusViewModel> ReadersBooks { get; set; } = [];

	protected override async Task OnInitializedAsync()
	{
		if (ReaderToManage is null)
		{
			var readerEntity = await BookKlubKornerService.GetReaderByIdAsync(Id);
			if (readerEntity is null)
			{
				NavigationManager.NotFound();
				return;
			}

			ReaderToManage = new ReaderViewModel(readerEntity);
			foreach (var statusId in ReaderToManage.BookStatusIds)
			{
				var statusEntity = await BookKlubKornerService.GetBookStatusByIdAsync(statusId);
				if (statusEntity is not null)
					ReadersBooks.Add(new BookStatusViewModel(statusEntity));
			}

			var books = await BookKlubKornerService.GetAllBooksAsync();

			// To get the list of available books, go through the global list of books
			// and ignore the ones that are in our BookStatuses list.
			foreach (var bookEntity in books)
			{
				if (ReadersBooks.Find(bs => bs.BookId == bookEntity.Id) is null)
				{
					_availableBooks.Add(new SelectBookViewModel()
					{
						Id = bookEntity.Id,
						Title = bookEntity.Title,
						Author = bookEntity.Author,
						IsSelected = false,
					});
				}
			}
		}
	}

	async Task UpdateBooksInCollection()
	{
		var theReader = await BookKlubKornerService.GetReaderByIdAsync(ReaderToManage!.Id);

		// TODO: I can't modify the collection inside the foreach, right? So remove them in a separate step.
		foreach (var outBook in _availableBooks)
		{
			if (outBook.IsSelected)
			{
				var theBook = await BookKlubKornerService.GetBookByIdAsync(outBook.Id);
				await BookKlubKornerService.CreateBookStatusAsync(theReader, theBook);
			}
		}
	}

	private List<SelectBookViewModel> _availableBooks = [];

	class SelectBookViewModel
	{
		//public Book BookEntity { get; set; }
		public int Id { get; set; }
		public string Title { get; set; }
		public string Author { get; set; }
		public bool IsSelected { get; set; }
	}

	private List<AltSelectBookViewModel> _availableBooksAlt = [];

	class AltSelectBookViewModel : BookViewModel
	{
		public bool IsSelected { get; set; }
	}

	string GetBookTitle(int bookId)
	{
		var bookEntity = BookKlubKornerService.GetBookById(bookId);
		return bookEntity?.Title;
	}

}