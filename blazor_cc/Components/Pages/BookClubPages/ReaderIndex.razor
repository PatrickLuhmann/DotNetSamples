@page "/bookclub/reader-index"

@using blazor_cc.ViewModels
@using BookKlubKorner.Domain
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IBookKlubKornerService BookKlubKornerService

<h1>Readers In The Book Club</h1>

<a href="/bookclub/reader-create">Create New Reader</a>
<a href="/bookclub">Back To Book Club Home</a>

<div>
	<QuickGrid Class="table" Items="QuickReaders">
		<PropertyColumn Property="reader => reader.Nickname" Sortable="true"/>
		<PropertyColumn Property="reader => reader.Biography"/>

		<TemplateColumn Context="reader">
			<a href="@($"bookclub/reader-edit?id={reader.Id}")">Edit</a>
		</TemplateColumn>
		<TemplateColumn Context="reader">
			<a href="@($"bookclub/reader-manage?id={reader.Id}")">Manage</a>
		</TemplateColumn>
		<TemplateColumn Context="reader">
			<a href="@($"bookclub/reader-delete?id={reader.Id}")">Delete</a>
		</TemplateColumn>
	</QuickGrid>
</div>

@code {
	List<ReaderViewModel> _readers = [];
	IQueryable<ReaderViewModel> QuickReaders => _readers.AsQueryable();

	protected override async Task OnInitializedAsync()
	{
		var readerEntities = await BookKlubKornerService.GetAllReadersAsync();
		_readers = [.. readerEntities.Select(re => new ReaderViewModel(re))];
	}

}