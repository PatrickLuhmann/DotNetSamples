@page "/bookclub/book-delete"

@using BookKlubKorner.Domain
@using BookKlubKorner.Model

@inject IBookKlubKornerService BookKlubKornerService
@inject NavigationManager NavigationManager

<PageTitle>Delete Book</PageTitle>

<p>Book Information</p>

@if (BookToDelete is null)
{
	<p>Searching the vast library for the book you requested...</p>
}
else
{
	<div>
		<dl class="row">
			<dt class="col-sm-2">Title</dt>
			<dd class="col-sm-10">@BookToDelete.BookEntity!.Title</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Author</dt>
			<dd class="col-sm-10">@BookToDelete.BookEntity!.Author</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Publisher</dt>
			<dd class="col-sm-10">@BookToDelete.BookEntity!.Publisher</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Number Of Pages</dt>
			<dd class="col-sm-10">@BookToDelete.BookEntity!.NumPages</dd>
		</dl>
		<dl class="row">
			<dt class="col-sm-2">Year Published</dt>
			<dd class="col-sm-10">@BookToDelete.BookEntity!.PublicationYear</dd>
		</dl>
		<p>Do you want to delete this book?</p>
		<EditForm method="post" Model="BookToDelete" OnValidSubmit="DeleteBook" FormName="delete" Enhance>
			<button type="submit" class="btn btn-danger" disabled="@(BookToDelete is null)">Delete</button>
			<a href="/bookclub/book-index" class="btn btn-info">Back To Book List</a>
		</EditForm>
	</div>
}

@code {

	[SupplyParameterFromQuery]
	private int Id { get; set; }

	[SupplyParameterFromForm]
	private DeleteBookViewModel? BookToDelete { get; set; }

	protected override async Task OnInitializedAsync()
	{
		if (BookToDelete is null)
		{
			var bookEntity = await BookKlubKornerService.GetBookByIdAsync(Id);
			if (bookEntity is null)
				NavigationManager.NotFound();
			else
				BookToDelete = new()
				{
					BookEntity = bookEntity
				};
		}
	}

	private async Task DeleteBook()
	{
		await BookKlubKornerService.DeleteBookAsync(Id);

		NavigationManager.NavigateTo("/bookclub");
	}

	class DeleteBookViewModel
	{
		public Book? BookEntity { get; init; }
	}

}