@page "/movies/edit"
@using Microsoft.EntityFrameworkCore
@using BlazorWebAppMovies.Models
@inject IDbContextFactory<BlazorWebAppMoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Movie</h2>
<hr/>
@if (Movie is null)
{
	<p>
		<em>Loading...</em>
	</p>
}
else
{
	<div class="row">
		<div class="col-md-4">
			<EditForm method="post" Model="Movie" OnValidSubmit="UpdateMovie" FormName="edit" Enhance>
				<DataAnnotationsValidator/>
				<ValidationSummary role="alert"/>
				@* We need Id in the form, otherwise it will be 0 when UpdateMovie is called. *@
				<input type="hidden" name="Movie.Id" value="@Movie.Id"/>
				<div class="mb-3">
					<label for="title" class="form-label">Title:</label>
					<InputText id="title" @bind-Value="Movie.Title" class="form-control"/>
					<ValidationMessage For="() => Movie.Title" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="releasedate" class="form-label">Release Date:</label>
					<InputDate id="releasedate" @bind-Value="Movie.ReleaseDate" class="form-control"/>
					<ValidationMessage For="() => Movie.ReleaseDate" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="genre" class="form-label">Genre:</label>
					<InputText id="genre" @bind-Value="Movie.Genre" class="form-control"/>
					<ValidationMessage For="() => Movie.Genre" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="price" class="form-label">Price:</label>
					<InputNumber id="price" @bind-Value="Movie.Price" class="form-control"/>
					<ValidationMessage For="() => Movie.Price" class="text-danger"/>
				</div>
				<div class="mb-3">
					<label for="rating" class="form-label">Rating:</label>
					<InputText id="rating" @bind-Value="Movie.Rating" class="form-control"/>
					<ValidationMessage For="() => Movie.Rating" class="text-danger"/>
				</div>
				<button type="submit" class="btn btn-primary">Save</button>
			</EditForm>
		</div>
	</div>
}

<div>
	<a href="/movies">Back to List</a>
</div>

@code {
	[SupplyParameterFromQuery] private int Id { get; set; }

	[SupplyParameterFromForm] private Movie? Movie { get; set; }

	// NOTE: This isn't just called when the page is first displayed.
	//       It is also called after the Save button is clicked.
	protected override async Task OnInitializedAsync()
	{
		await using var context = await DbFactory.CreateDbContextAsync();
		// If this method is being called due to the user clicking the Save button,
		// then Movie will not be null and will include the changed values. In this
		// case we don't want to fetch the record from the database because that
		// would overwrite the user input.
		Movie ??= await context.Movie.FirstOrDefaultAsync(m => m.Id == Id);

		if (Movie is null)
		{
			NavigationManager.NotFound();
		}
	}

	// To protect from overposting attacks, enable the specific properties you want to bind to.
	// For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
	private async Task UpdateMovie()
	{
		await using var context = await DbFactory.CreateDbContextAsync();
		context.Attach(Movie!).State = EntityState.Modified;

		try
		{
			await context.SaveChangesAsync();
		}
		catch (DbUpdateConcurrencyException)
		{
			if (!MovieExists(Movie!.Id))
			{
				NavigationManager.NotFound();
			}
			else
			{
				throw;
			}
		}

		NavigationManager.NavigateTo("/movies");
	}

	private bool MovieExists(int id)
	{
		using var context = DbFactory.CreateDbContext();
		return context.Movie.Any(e => e.Id == id);
	}

}
